# Local review configuration
.gitreview

# Real capture material is local-only; keep its manifest visible.
/test/svr/real/*
!/test/svr/real/MANIFEST.md

# Generated synthetic captures
/test/svr/synthetic/*.pcap
/test/svr/synthetic/*.pcapng
/test/svr/synthetic/*.cap

# Native build output
/native/*.so

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Source code browsing
.tags
.tags_sorted_by_file
tags
cscope.*

# macOS
*.fuse_hidden*
.DS_Store
._.DS_Store

# Editor files
*.sublime-*
*.sw*
*~
BROWSE
